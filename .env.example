# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/btcsolar

# ─── Payload ────────────────────────────────────────────────────
# Used to encrypt JWT tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, links, sitemap. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs — generate with: openssl rand -hex 32
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to sign preview URLs (HMAC). Never put this value into client-visible query params.
# Generate with: openssl rand -hex 32
PREVIEW_SECRET=YOUR_SECRET_HERE

# DANGEROUS: enables POST /next/seed which wipes CMS data. Never set on production.
# ENABLE_SEED=true

# ─── Cloudflare Turnstile (optional but recommended in production) ─
# Both keys required together. Without them: honeypot + IP rate-limit only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─── Cloudflare R2 (production only — leave empty for local dev) ─
# Create bucket at dash.cloudflare.com → R2 → Create bucket
R2_BUCKET=
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2 API token with Object Read & Write — dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL of the bucket: custom domain or https://<BUCKET>.r2.dev (enable public access in dash)
R2_PUBLIC_URL=
